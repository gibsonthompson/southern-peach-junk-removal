# ---------------------------------------------------------------------------
# Peach State Junk Removal - environment variables
# Copy this file to .env.local and fill in real values there.
# Never commit .env.local. Nothing secret belongs in this example file.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://peachstatejunkremoval.com

# --- Phase 5: quote form pipeline (not wired up yet) ---

# Supabase (database + photo storage for quote submissions)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMS notification to the owner on every form submission.
# Reuse the existing number/credentials we always use.
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
OWNER_NOTIFY_NUMBER=
